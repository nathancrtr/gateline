{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "core/src/**/*.ts",
    "core/test/**/*.ts",
    "cli/src/**/*.ts",
    "framework/src/**/*.ts",
    "framework/test/**/*.ts",
    "orchestrator/src/**/*.ts",
    "orchestrator/test/**/*.ts",
    "server/src/**/*.ts",
    "server/test/**/*.ts",
    "runner-agent/src/**/*.ts",
    "runner-agent/test/**/*.ts",
    "fixtures/src/**/*.ts"
  ]
}
